<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="30dp">

    <ImageButton
        android:id="@+id/btnVoltar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentTop="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_revert"
        android:contentDescription="Voltar"
        android:tint="#00FF00" />

    <TextView
        android:id="@+id/titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:text="📡 RASTREADOR DE IP"
        android:textColor="#00FF00"
        android:textSize="20sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/editIpAlvo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/titulo"
        android:layout_marginTop="20dp"
        android:background="#111111"
        android:hint="Digite o IP (ou deixe vazio para o seu)"
        android:padding="12dp"
        android:textColor="#00FF00"
        android:textColorHint="#444444"
        android:textSize="14sp"
        android:inputType="text"
        android:fontFamily="monospace"/>

    <Button
        android:id="@+id/btnRastrear"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/editIpAlvo"
        android:layout_marginTop="10dp"
        android:backgroundTint="#00FF00"
        android:text="LANÇAR RASTREIO"
        android:textColor="#000000"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/progressoScan"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_below="@id/btnRastrear"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:indeterminateTint="#00FF00"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/btnCopiar"
        android:layout_below="@id/progressoScan"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="#0A0A0A"
        android:padding="10dp">

        <TextView
            android:id="@+id/txtResultadoFinal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text=">> SISTEMA PRONTO PARA RASTREIO..."
            android:textColor="#00FF00"
            android:textSize="13sp" />
    </ScrollView>

    <Button
        android:id="@+id/btnCopiar"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="20dp"
        android:backgroundTint="#111111"
        android:text="📋 COPIAR RELATÓRIO"
        android:textColor="#00FF00"
        android:textStyle="bold" />

</RelativeLayout>
